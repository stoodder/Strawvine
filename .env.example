# Local development
DATABASE_URL=postgres://postgres@localhost:5432/strawvine
# The single password used to sign in (production: 12+ characters, refuses known defaults)
APP_PASSWORD=change-me
# Signs session cookies. Production refuses anything weaker than `openssl rand -hex 32`.
SESSION_SECRET=replace-with-a-long-random-string
PORT=3000
# Behind a TLS-terminating proxy (Heroku): trust X-Forwarded-For/-Proto. Defaults to on when DYNO is set.
# TRUST_PROXY=1
