{
  "name": "strawvine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "export BUILD_ID=\"${BUILD_ID:-$(date +%s)}\" && npm run build:web && npm run build:api && npm run build:compress && node -e \"require('node:fs').writeFileSync('dist/build-id.txt', process.env.BUILD_ID + '\\n')\"",
    "build:web": "vite build",
    "build:api": "esbuild src/server/index.ts src/server/migrate.ts src/server/restore.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist/server",
    "build:compress": "tsx src/server/precompress.ts dist/web",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/migrate.ts",
    "restore": "tsx --env-file-if-exists=.env src/server/restore.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "check:style": "node scripts/check-style.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
